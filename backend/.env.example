# Port the Express server listens on
PORT=8000

# PostgreSQL connection string
# Local example: postgresql://postgres:yourpassword@localhost:5432/airbnbdb?schema=public&sslmode=disable
# Hosted example (Render/Supabase/etc.): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/airbnbdb?schema=public&sslmode=disable

# Secret used to sign JWT auth tokens - use a long random string
JWT_SECRET=replace_with_a_long_random_string

# The deployed frontend's origin (used for CORS + Socket.IO). Must be an
# exact origin with no trailing slash, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Set to "production" when deployed - switches the auth cookie to
# secure + sameSite=none, required for the frontend/backend living on
# different domains. Leave unset for local development.
NODE_ENV=development
